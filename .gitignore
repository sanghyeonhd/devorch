# devorch .gitignore

# Build outputs
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.cover
coverage.html

# Database files
*.db
*.db-shm
*.db-wal

# Log files
logs/
*.log

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Go workspace file
go.work

# Dependency directories (in case of vendoring)
vendor/

# Environment files
.env
.env.local
.env.*.local

# Compare folder (reference code, not part of project)
docs/compare/

# Temporary files
tmp/
temp/
*.tmp
*.temp
